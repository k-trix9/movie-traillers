NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filmora?schema=public
DATABASE_SSL=false

# Use a long random value (at least 32 characters). Never commit your real .env.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:4000
SESSION_COOKIE_NAME=filmora.sid

# Create these values in your Flutterwave merchant dashboard.
# The starter uses Flutterwave Standard hosted checkout and manual monthly renewal.
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_REDIRECT_URL=http://localhost:4000/api/billing/flutterwave/callback
FLW_PAYMENT_OPTIONS=card

# Cloudflare Stream credentials. Keep the API token on the server only.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_CUSTOMER_CODE=
CF_ALLOWED_ORIGIN=localhost
TRUST_CF_IP_COUNTRY=false

DEFAULT_CURRENCY=USD
# Optional RWF prices for Rwanda mobile-money checkout. Set your approved amounts before seeding.
RWF_BASIC_AMOUNT=
RWF_STANDARD_AMOUNT=
RWF_FAMILY_AMOUNT=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password-before-seeding

# LOCAL TESTING ONLY. When true (and NODE_ENV=development) the plan buttons show a
# "Test activate" option that grants a month of access without Flutterwave.
# It is forced off in production regardless of this value.
DEV_PAYMENT_BYPASS=false
